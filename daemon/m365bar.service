[Unit]
Description=m365bar: Microsoft 365 calendar/Teams state for the Omarchy bar
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
ExecStart=%h/.local/bin/m365bar run
Restart=on-failure
# uv reports a SIGTERM'd child as 143; a normal stop is not a failure.
SuccessExitStatus=143
RestartSec=30
Nice=10

[Install]
WantedBy=graphical-session.target
